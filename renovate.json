{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/.+/Chart\\.yaml$/"
    ]
  },

  "helm-values": {
    "managerFilePatterns": [
      "/kubernetes/.+/values\\.yaml$/"
    ]
  },

  "packageRules": [
    {
      "matchDatasources": ["helm"],
      "groupName": "Helm charts",
      "schedule": ["every weekend"],
      "automerge": false,
      "labels": ["dependencies", "helm"]
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "Docker images",
      "schedule": ["every weekend"],
      "automerge": false,
      "labels": ["dependencies", "docker"]
    },
    {
      "description": "opensearch-operator 3.x drops kube-rbac-proxy and requires cert-manager; pinned at 2.8.4 until we install cert-manager",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["opensearch-operator"],
      "allowedVersions": "< 3.0.0"
    }
  ],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}
